# 复制本文件为 .env 后填写真实值，然后重启后端：python run.py
# 接口为 OpenAI 兼容：POST {LLM_API_BASE}/chat/completions

# 根地址必须包含 /v1（程序会再拼接 /chat/completions）
# OpenAI 官方：
# LLM_API_BASE=https://api.openai.com/v1
# 国内 DeepSeek：
# LLM_API_BASE=https://api.deepseek.com/v1
# 阿里云通义（OpenAI 兼容模式，以控制台为准）：
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# 常用模型名示例：gpt-4o-mini、gpt-4o、deepseek-chat、qwen-turbo 等（取决于服务商）
